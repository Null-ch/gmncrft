{$DOMAIN} {
	# /backup и /client - публичные HTML-страницы (без авторизации, доступны всем по ссылке).
	# Страница сама запускает скачивание нужного файла через JS.
	handle /backup {
		reverse_proxy link-server:8080
	}
	handle /client {
		reverse_proxy link-server:8080
	}

	# Сами файлы - тоже без авторизации снаружи, но токен всё равно подставляется
	# при проксировании во внутреннюю docker-сеть (defense in depth, не видно снаружи).
	handle /backup/file {
		rewrite * /latest?token={$BACKUP_LINK_TOKEN}
		reverse_proxy link-server:8080
	}
	handle /client/file {
		rewrite * /client-file?token={$BACKUP_LINK_TOKEN}
		reverse_proxy link-server:8080
	}

	handle {
		respond "Not found" 404
	}
}
