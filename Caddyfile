{$DOMAIN} {
	# Пароль спрашивается только при реальном скачивании файла - сами страницы
	# (главная, /backup, /client) открыты всем без авторизации.
	basic_auth /backup/file* {
		mc {$HASHED_PASSWORD}
	}
	basic_auth /client/file* {
		mc {$HASHED_PASSWORD}
	}

	handle /backup/file {
		rewrite * /latest?token={$BACKUP_LINK_TOKEN}
		reverse_proxy link-server:8080
	}
	handle /client/file {
		rewrite * /client-file?token={$BACKUP_LINK_TOKEN}
		reverse_proxy link-server:8080
	}

	# Главная, /backup, /client - HTML-страницы, отдаёт link-server как есть.
	handle {
		reverse_proxy link-server:8080
	}
}
