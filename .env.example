# Скопируйте этот файл в .env и отредактируйте значения перед запуском:
#   cp .env.example .env

# --- Сеть ---
SERVER_PORT=25565

# --- Установка Forge ---
# Имя installer-jar в корне репозитория (docker-compose монтирует именно этот файл
# в контейнер и ставит Forge из него, без обращения к maven.minecraftforge.net).
# Актуальные версии: https://files.minecraftforge.net/net/minecraftforge/forge/index_1.21.1.html
FORGE_INSTALLER_FILE=forge-1.21.1-52.1.16-installer.jar

# --- Игровые настройки ---
MEMORY=4G
MOTD=My Forge 1.21.1 Server
DIFFICULTY=normal
MODE=survival
MAX_PLAYERS=20
VIEW_DISTANCE=10
SIMULATION_DISTANCE=10
SPAWN_PROTECTION=0
ALLOW_NETHER=true
PVP=true
# true (рекомендуется) = проверка лицензии Mojang, WHITELIST/OPS ниже работают напрямую.
# false = офлайн/пиратский режим - тогда WHITELIST/OPS здесь использовать НЕЛЬЗЯ
# (UUID не совпадёт), только ENABLE_WHITELIST=true + добавление игроков вручную через
# консоль сервера после первого подключения. Подробности в README.
ONLINE_MODE=true
TZ=Europe/Moscow

ENABLE_WHITELIST=false
# Список игроков через запятую, например: Steve,Alex (работает только при ONLINE_MODE=true)
WHITELIST=
# Операторы через запятую (работает только при ONLINE_MODE=true)
OPS=

# --- RCON (обязательно задать перед первым запуском!) ---
# Используется для консоли (scripts/console.sh) и автоматических бэкапов. Наружу порт НЕ публикуется.
RCON_PASSWORD=change_me_to_a_strong_password

# --- Бэкапы ---
BACKUP_INTERVAL=24h
PRUNE_BACKUPS_DAYS=7

# --- Бессрочная ссылка на бэкап/клиент-пак (link-server + caddy) ---
# Домен, А-записью указывающий на этот VPS (Caddy сам получит HTTPS-сертификат).
LINK_DOMAIN=change-me.example.com
# Простой пароль для скачивания бэкапа/клиент-пака - своя форма в стиле сайта (не
# нативный Basic Auth браузера). Бот пишет его прямо в Discord, так что делать длинным
# и случайным смысла нет. Сгенерировать короткий: openssl rand -hex 5
DOWNLOAD_PASSWORD=change_me_to_a_simple_password
# Что показывать на страницах как адрес сервера и MOTD.
SERVER_ADDRESS=2.26.224.164:25565
# Токен для Discord-бота: через него бот забирает заявки на игру и одобряет их
# (= MINECRAFT_API_TOKEN в .env бота). Секретный, в отличие от DOWNLOAD_PASSWORD.
# Сгенерировать: openssl rand -hex 24
BOT_API_TOKEN=

# --- Прочее ---
FORGE_FORCE_REINSTALL=false
