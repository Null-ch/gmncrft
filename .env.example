# Скопируйте этот файл в .env и отредактируйте значения перед запуском:
#   cp .env.example .env

# --- Сеть ---
SERVER_PORT=25565

# --- Версии ---
MC_VERSION=1.21.1
# Рекомендованная версия Forge для 1.21.1 (см. https://files.minecraftforge.net/net/minecraftforge/forge/index_1.21.1.html)
FORGE_VERSION=52.1.0

# --- Игровые настройки ---
MEMORY=4G
MOTD=My Forge 1.21.1 Server
DIFFICULTY=normal
MODE=survival
MAX_PLAYERS=20
VIEW_DISTANCE=10
SIMULATION_DISTANCE=10
SPAWN_PROTECTION=0
ALLOW_NETHER=true
PVP=true
ONLINE_MODE=true
TZ=Europe/Moscow

# Список игроков через запятую, например: Steve,Alex
WHITELIST=
# Операторы через запятую
OPS=

# --- RCON (обязательно задать перед первым запуском!) ---
# Используется для консоли и автоматических бэкапов. Наружу порт НЕ публикуется.
RCON_PASSWORD=change_me_to_a_strong_password

# --- Бэкапы ---
BACKUP_INTERVAL=24h
PRUNE_BACKUPS_DAYS=7

# --- Прочее ---
FORGE_FORCE_REINSTALL=false
